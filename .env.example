# ==============================================================================
# YCT Alert — Root Environment Configuration Template
# Notice: Copy to .env for local development. Never commit production secrets.
# ==============================================================================

# Node Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Services / API
# ------------------------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1
API_PUBLIC_URL=http://localhost:4000

# Primary Development Database (Dedicated PostgreSQL instance)
# SAFEGUARD: Do NOT point this to existing databases (e.g. yct_postgres or YCT Map DB)
DATABASE_URL=postgresql://alert_user:alert_password@localhost:5432/yct_alert_dev

# Isolated Test Database (Strictly used during automated tests & simulation)
TEST_DATABASE_URL=postgresql://alert_user:alert_password@localhost:5432/yct_alert_test

# Storage Configuration
# local: uses local disk in development
# s3: uses S3-compatible cloud object storage (Cloudflare R2, MinIO, AWS S3)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./tmp/media_uploads
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=yct-alert-media-dev
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# YCT Map Upstream Ingestion
YCT_MAP_BASE_URL=https://yct-map.onrender.com
GEOGRAPHY_SYNC_INTERVAL_MINUTES=15

# Security & Secrets
# Random 64-char hex strings in production
ADMIN_SESSION_SECRET=change-me-to-a-secure-random-secret-in-production-min-32-chars
ADMIN_BOOTSTRAP_SECRET=change-me-to-a-secure-one-time-bootstrap-token

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed web and mobile origins (e.g. Android WebView https://localhost)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://localhost


# ------------------------------------------------------------------------------
# Client Applications
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000

