{
  "name": "@yctalert/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate:up": "tsx scripts/migrate.ts up",
    "migrate:down": "tsx scripts/migrate.ts down",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "test:safeguard": "tsx --test tests/database-safeguard.test.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "bootstrap:admin:ensure": "tsx scripts/bootstrap-admin.ts --if-missing"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@yctalert/contracts": "*",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "node-pg-migrate": "9.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
